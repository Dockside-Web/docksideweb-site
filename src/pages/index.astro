---
import {
  lighthouseScores,
  lighthouseChecks,
  performanceMinis
} from "../data/performanceInfo.ts";
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import PricingPlans from "../components/PricingPlans.astro";
import { startingMonthlyPrice } from "../data/pricing.ts";
import ReviewsFeatured from "../components/ReviewsFeatured.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { clientProjects } from "../data/clientInfo.ts";
import CTACard from "../components/CTACard.astro";
import { Image } from "astro:assets";
import heroDock from "../assets/hero-dock.webp";
import heroDockForeground from "../assets/hero-dock-foreground.webp";
import dockImage from "../assets/dock.jpg";

import { Gauge, Rabbit, Coffee, Search, MapPin, Phone, Moon, Star, BadgeCheck, ArrowRight } from "lucide-astro";

const metaDescription =
  "Modern, high-performance web development for small businesses in Charleston and beyond. We build custom sites designed to scale your brand.";

const featuredProjects = clientProjects.filter(p => p.featured);
---

<Layout description={metaDescription}>
  <!-- ── HERO ── -->
  <!-- Three layers: full photo (sky) → headline → cutout foreground (sky removed). The headline
       drifts down slower than the page scrolls, so the dock and water slide up over it. -->
  <section id="hero" class="relative h-svh min-h-160 overflow-hidden bg-navy">
    <!-- Back layer: full photo with sky -->
    <Image
      src={heroDock}
      alt=""
      widths={[828, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-bottom"
    />
    <!-- Navy wash at the top so the white nav stays readable over the light sky -->
    <div class="absolute inset-x-0 top-0 h-48 bg-linear-to-b from-navy/80 to-transparent"></div>

    <!-- Headline (between the sky and the foreground) -->
    <div
      id="hero-headline"
      class="absolute inset-x-0 top-[18%] md:top-[20%] px-4 text-center will-change-transform">
      <h1
        class="mx-auto max-w-4xl font-bold text-navy leading-[1.02] tracking-tight text-5xl sm:text-6xl lg:text-7xl xl:text-8xl text-balance animate-fade-in-up">
        Custom websites built for <span class="italic">small businesses.</span>
      </h1>
    </div>

    <!-- Front layer: same photo with the sky cut out -->
    <Image
      src={heroDockForeground}
      alt="Wooden dock and calm blue water on a sunny day"
      widths={[828, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-bottom"
    />
    <!-- Navy fade at the bottom for the supporting copy -->
    <div
      class="absolute inset-x-0 bottom-0 h-[55%] bg-linear-to-t from-navy/90 via-navy/50 to-transparent">
    </div>

    <!-- Supporting copy + actions -->
    <div class="absolute inset-x-0 bottom-0 px-4 pb-32 md:pb-36 text-center">
      <p
        class="mx-auto max-w-xl text-xl md:text-2xl font-medium leading-snug text-white text-pretty drop-shadow-md">
        A fast, professional website that brings in customers.
        <br />
        <span class="text-gold">As low as $0 down and {startingMonthlyPrice}/month.</span>
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="w-full sm:w-auto">
          <Button variant="gold" size="lg" withArrow class="w-full sm:w-auto px-10 shadow-navy/40">
            Get Your Website
          </Button>
        </a>
        <a href="/portfolio/" class="w-full sm:w-auto">
          <Button variant="white" size="lg" class="w-full sm:w-auto px-10 shadow-navy/40">
            See Our Work
          </Button>
        </a>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-0">
      <svg
        class="relative block w-full h-16 md:h-24"
        viewBox="0 0 1440 320"
        preserveAspectRatio="none"
        aria-hidden="true">
        <path
          fill="#F8FAFC"
          d="M0,160L48,176C96,192,192,224,288,213.3C384,203,480,149,576,149.3C672,149,768,203,864,218.7C960,235,1056,213,1152,186.7C1248,160,1344,128,1392,112L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
        ></path>
      </svg>
    </div>
  </section>

  <!-- ── Services Overview ── -->
  <Section bg="light">
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-12 md:mb-16 reveal-up opacity-0">
      <h2
        class="lg:col-span-7 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] text-navy">
        Never worry about your website again.
      </h2>
      <p class="lg:col-span-5 text-lg md:text-xl text-slate-600 leading-relaxed">
        From your first website to ongoing support, we handle everything you need to look
        professional online and make it easy for customers to reach you.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5">
      <!-- Performance -->
      <a href="/web-design/" class="group flex flex-col gap-5 reveal-up opacity-0">
        <div
          class="flex flex-col aspect-4/5 p-8 rounded-4xl overflow-hidden transition duration-300 group-hover:-translate-y-1.5 group-hover:shadow-xl bg-teal text-navy">
          <h3 class="text-2xl md:text-3xl font-semibold leading-tight text-navy">
            Loads before<br />they blink.
          </h3>
          <div class="mt-auto">
            <Rabbit class="h-9 w-9 mb-3" stroke-width={1.75} />
            <p class="font-display text-7xl md:text-8xl font-bold leading-none">99</p>
            <p class="mt-2 text-sm font-semibold uppercase tracking-wider text-navy/70">
              Google speed score
            </p>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed">
          <strong class="font-semibold text-navy">Performance.</strong> A fast site feels more professional
          and keeps customers from leaving. Pages load fast and respond instantly.
        </p>
      </a>

      <!-- Hosting -->
      <a
        href="/hosting-and-support/"
        class="group flex flex-col gap-5 reveal-up opacity-0"
        style="transition-delay: 100ms">
        <div
          class="flex flex-col aspect-4/5 p-8 rounded-4xl overflow-hidden transition duration-300 group-hover:-translate-y-1.5 group-hover:shadow-xl bg-navy text-white">
          <h3 class="text-2xl md:text-3xl font-semibold leading-tight text-white">
            You run the business.<br />We run the site.
          </h3>
          <div class="mt-auto flex flex-col gap-4">
            <Coffee class="h-10 w-10 text-gold" stroke-width={1.75} />
            <ul class="space-y-2 text-white/80">
              <li>Hosting &amp; security</li>
              <li>Unlimited updates</li>
              <li>Live in 2-3 weeks</li>
            </ul>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed">
          <strong class="font-semibold text-navy">Hosting &amp; updates.</strong> We handle hosting, security,
          and content changes so your site stays online, current, and worry-free.
        </p>
      </a>

      <!-- Mobile -->
      <a
        href="/web-design/"
        class="group flex flex-col gap-5 reveal-up opacity-0"
        style="transition-delay: 200ms">
        <div
          class="flex flex-col aspect-4/5 p-8 rounded-4xl overflow-hidden transition duration-300 group-hover:-translate-y-1.5 group-hover:shadow-xl relative isolate text-white">
          <Image
            src={dockImage}
            alt="Wooden dock stretching into the water at sunset"
            class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            widths={[400, 700]}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
          />
          <div
            class="absolute inset-0 -z-10 bg-linear-to-b from-navy/60 via-navy/10 to-transparent">
          </div>
          <h3 class="text-2xl md:text-3xl font-semibold leading-tight text-white drop-shadow">
            Made for the phone in their pocket.
          </h3>
        </div>
        <p class="text-slate-600 leading-relaxed">
          <strong class="font-semibold text-navy">Mobile friendly.</strong> Most customers visit from
          their phone. Your site looks sharp and loads fast on any screen, even on cellular.
        </p>
      </a>

      <!-- SEO -->
      <a
        href="/seo/"
        class="group flex flex-col gap-5 reveal-up opacity-0"
        style="transition-delay: 300ms">
        <div
          class="flex flex-col aspect-4/5 p-8 rounded-4xl overflow-hidden transition duration-300 group-hover:-translate-y-1.5 group-hover:shadow-xl bg-gold text-navy">
          <h3 class="text-2xl md:text-3xl font-semibold leading-tight text-navy">
            Found by the<br />folks next door.
          </h3>
          <div class="mt-auto flex flex-col gap-3">
            <div class="flex items-center gap-3 rounded-full bg-white px-4 py-3 shadow-md">
              <Search class="h-5 w-5 shrink-0 text-slate-500" />
              <span class="text-sm text-slate-700 truncate">best bakery near me</span>
            </div>
            <div class="flex items-center gap-3 rounded-2xl bg-white/60 px-4 py-3">
              <MapPin class="h-5 w-5 shrink-0 text-navy" />
              <span class="text-sm font-semibold">Your Business</span>
            </div>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed">
          <strong class="font-semibold text-navy">Local SEO.</strong> We structure your pages so Google
          knows exactly what you do and who you serve, so you show up on Search and Maps for the searches that matter.
        </p>
      </a>
    </div>
  </Section>

  <!-- ── Why a Website ── -->
  <!-- Follows how a customer finds a local business today, step by step, with arrows between the steps on desktop -->
  <Section bg="tealLight">
    <h2 class="max-w-3xl text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] text-navy text-balance reveal-up opacity-0">
      Your next customer is looking for you <span class="italic text-teal-hover">right now.</span>
    </h2>

    <!-- Each card is a 3-row subgrid (visual, heading, text) so headings line up across a row even when one visual is taller -->
    <ol class="mt-12 md:mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-10">
      <!-- 1. Search -->
      <li class="relative grid grid-rows-subgrid row-span-3 gap-y-0 rounded-4xl bg-white p-7 shadow-sm reveal-up opacity-0">
        <div class="self-center">
          <div id="search-box" class="flex items-center gap-2.5 rounded-full border border-slate-200 bg-slate-50 px-4 py-3" aria-hidden="true">
            <Search class="size-4 shrink-0 text-teal-hover" />
            <span class="flex min-w-0 items-center text-sm text-slate-700">
              <span id="search-typing" class="truncate">roofer near me</span>
              <span class="ml-0.5 h-4 w-px shrink-0 bg-navy animate-caret-blink motion-reduce:animate-none"></span>
            </span>
          </div>
        </div>
        <h3 class="mt-6 text-2xl font-semibold text-navy">They search.</h3>
        <p class="mt-2 text-slate-600 leading-relaxed">
          People look on Google before they pick up the phone. If you're not there, you're not
          an option.
        </p>
        <span class="absolute top-1/2 -right-9 z-10 hidden size-8 -translate-y-1/2 place-items-center rounded-full bg-white text-teal-hover shadow-md lg:grid" aria-hidden="true"><ArrowRight class="size-4" /></span>
      </li>

      <!-- 2. Size you up -->
      <li class="relative grid grid-rows-subgrid row-span-3 gap-y-0 rounded-4xl bg-white p-7 shadow-sm reveal-up opacity-0" style="transition-delay: 100ms">
        <div class="self-center">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" aria-hidden="true">
            <div class="flex items-center gap-1.5">
              <p class="truncate text-sm font-semibold text-navy">Your Business</p>
              <BadgeCheck class="size-4 shrink-0 text-teal-hover" />
            </div>
            <div class="mt-1 flex items-center gap-1.5 text-xs text-slate-500">
              <span class="font-semibold text-navy">5.0</span>
              <span class="flex gap-0.5 text-gold">
                <Star class="size-3 fill-current" /><Star class="size-3 fill-current" /><Star class="size-3 fill-current" /><Star class="size-3 fill-current" /><Star class="size-3 fill-current" />
              </span>
              <span>(48 reviews)</span>
            </div>
          </div>
        </div>
        <h3 class="mt-6 text-2xl font-semibold text-navy">They size you up.</h3>
        <p class="mt-2 text-slate-600 leading-relaxed">
          In a few seconds they decide if you look trustworthy. A professional site makes that
          an easy yes.
        </p>
        <span class="absolute top-1/2 -right-9 z-10 hidden size-8 -translate-y-1/2 place-items-center rounded-full bg-white text-teal-hover shadow-md lg:grid" aria-hidden="true"><ArrowRight class="size-4" /></span>
      </li>

      <!-- 3. Reach out -->
      <li class="relative grid grid-rows-subgrid row-span-3 gap-y-0 rounded-4xl bg-white p-7 shadow-sm reveal-up opacity-0" style="transition-delay: 200ms">
        <!-- Buttons share a row when they fit, and wrap when the card is too narrow -->
        <div class="self-center flex flex-wrap gap-2" aria-hidden="true">
          <span class="flex flex-1 items-center justify-center gap-1.5 whitespace-nowrap rounded-full bg-gold px-3 py-2 text-xs font-semibold text-navy">
            <Phone class="size-3.5" /> Call now
          </span>
          <span class="flex flex-1 items-center justify-center gap-1.5 whitespace-nowrap rounded-full border border-navy/20 px-3 py-2 text-xs font-semibold text-navy">
            <MapPin class="size-3.5" /> Get directions
          </span>
        </div>
        <h3 class="mt-6 text-2xl font-semibold text-navy">They reach out.</h3>
        <p class="mt-2 text-slate-600 leading-relaxed">
          Calling, booking, or finding your door is one tap away, so interest turns into
          business.
        </p>
        <span class="absolute top-1/2 -right-9 z-10 hidden size-8 -translate-y-1/2 place-items-center rounded-full bg-white text-teal-hover shadow-md lg:grid" aria-hidden="true"><ArrowRight class="size-4" /></span>
      </li>

      <!-- 4. Works while you sleep -->
      <li class="relative grid grid-rows-subgrid row-span-3 gap-y-0 rounded-4xl bg-white p-7 shadow-sm reveal-up opacity-0" style="transition-delay: 300ms">
        <div class="self-center">
          <div class="flex items-center gap-3 rounded-2xl bg-navy px-4 py-3" aria-hidden="true">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-white/10">
              <Moon class="size-4 text-gold" />
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-white leading-tight">New inquiry</p>
              <p class="text-xs text-white/60">Sunday, 11:42 PM</p>
            </div>
          </div>
        </div>
        <h3 class="mt-6 text-2xl font-semibold text-navy">It works while you sleep.</h3>
        <p class="mt-2 text-slate-600 leading-relaxed">
          Your site answers questions and takes inquiries around the clock, even when you're
          closed.
        </p>
      </li>
    </ol>
  </Section>

  <!-- ── Portfolio ── -->
  <Section bg="light">
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-14 reveal-up opacity-0">
      <h2
        class="max-w-2xl text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] text-navy text-balance">
        Websites we're proud to put our name on.
      </h2>
      <a
        href="/portfolio/"
        class="inline-flex items-center gap-2 font-semibold text-navy hover:text-teal-hover hover:gap-3 transition-all duration-300 shrink-0">
        See all projects
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
    <div class="reveal-up opacity-0">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        {featuredProjects.map(project => <ProjectCard project={project} />)}
      </div>
    </div>
  </Section>

  <!-- ── Performance ── -->
  <Section bg="navy" class="md:py-28!">
    <div class="relative">
      <div class="relative grid gap-12 lg:grid-cols-2 lg:gap-20 items-center">
        <!-- Left column — slides in from left -->
        <div class="reveal-left opacity-0">
          <h2
            class="text-4xl leading-[1.05] tracking-tight md:text-5xl lg:text-6xl font-bold text-white text-balance">
            Built to load in
            <span class="italic text-teal">under a second.</span>
          </h2>
          <p class="mt-6 max-w-md text-lg text-white/75 text-pretty">
            Sites built with modern tools load almost instantly, which keeps visitors around longer
            and helps you rank higher on Google. No technical knowledge required on your end.
          </p>

          <div class="mt-10 grid grid-cols-2 gap-4">
            {
              performanceMinis.map((m, i) => (
                <div
                  class="rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur reveal-up opacity-0"
                  style={`transition-delay: ${i * 80 + 200}ms`}>
                  <m.icon class="h-4 w-4 text-gold" />
                  <div class="mt-3 text-lg text-white">{m.label}</div>
                  <div class="text-sm text-white/65 mt-0.5">{m.sub}</div>
                </div>
              ))
            }
          </div>
          <a
            href="/seo/"
            class="inline-flex items-center gap-2 text-gold font-semibold hover:gap-3 transition-all duration-300 mt-8">
            See how speed helps you rank
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Right column — slides in from right, then scores animate -->
        <div
          class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur md:p-10 reveal-right opacity-0">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs uppercase tracking-widest text-white/60">Google Lighthouse</div>
              <div class="text-2xl text-white mt-1">What our sites score</div>
            </div>
            <Gauge class="h-5 w-5 text-teal" />
          </div>

          <div class="mt-8 grid grid-cols-2 gap-4" id="lighthouse-scores">
            {
              lighthouseScores.map(b => (
                <div class="text-center">
                  <div class="relative mx-auto h-24 w-24">
                    <svg viewBox="0 0 36 36" class="h-full w-full -rotate-90">
                      <circle
                        cx="18"
                        cy="18"
                        r="15.9"
                        fill="none"
                        stroke="rgba(255,255,255,0.1)"
                        stroke-width="3"
                      />
                      <circle
                        cx="18"
                        cy="18"
                        r="15.9"
                        fill="none"
                        stroke="#6dbbb5"
                        stroke-width="3"
                        stroke-dasharray="0, 100"
                        stroke-linecap="round"
                        class="score-ring"
                        data-score={b.score}
                      />
                    </svg>
                    <div
                      class="absolute inset-0 flex items-center justify-center text-xl font-semibold text-white score-number"
                      data-score={b.score}>
                      0
                    </div>
                  </div>
                  <div class="mt-2 text-xs uppercase tracking-widest text-white/65">{b.label}</div>
                </div>
              ))
            }
          </div>

          <div class="mt-8 space-y-3 border-t border-white/10 pt-6">
            {
              lighthouseChecks.map((m, i) => (
                <div
                  class="flex items-center justify-between text-sm reveal-up opacity-0"
                  style={`transition-delay: ${i * 80}ms`}>
                  <span class="text-white/75">{m.label}</span>
                  <span class="text-gold font-semibold">{m.value}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- ── Pricing ── -->
  <Section bg="light">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-14 md:mb-20 reveal-up opacity-0">
      <h2 class="max-w-2xl text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] text-navy text-balance">
        Simple pricing. No surprises.
      </h2>
      <a
        href="/pricing/#pricing-faq"
        class="inline-flex items-center gap-2 font-semibold text-navy hover:text-teal-hover hover:gap-3 transition-all duration-300 shrink-0">
        Pricing FAQs
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
    <PricingPlans />
    <p class="mt-14 md:mt-16 text-center text-slate-600">
      Want help with your Google Business Profile or reviews too?
      <a
        href="/pricing/#add-ons"
        class="ml-1 font-semibold text-navy underline decoration-teal decoration-2 underline-offset-4 hover:text-teal-hover">
        See add-on services
      </a>
    </p>
  </Section>

  <!-- ── Reviews ── -->
  <Section bg="white" id="reviews">
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-14 reveal-up opacity-0">
      <h2
        class="max-w-2xl text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] text-navy text-balance">
        Don't just take our word for it.
      </h2>
      <a
        href="/reviews/"
        class="inline-flex items-center gap-2 font-semibold text-navy hover:text-teal-hover hover:gap-3 transition-all duration-300 shrink-0">
        All reviews
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
    <div class="reveal-up opacity-0">
      <ReviewsFeatured />
    </div>
  </Section>

  <CTACard bg="white" />
</Layout>

<script>
  // ── Shared reveal observer (mirrors SEO page pattern) ──
  function initRevealAnimations() {
    const revealObserver = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("animate-in");
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document
      .querySelectorAll(".reveal-left, .reveal-right, .reveal-up")
      .forEach(el => revealObserver.observe(el));
  }

  // ── Lighthouse score rings + counters ──
  function initLighthouseAnimations() {
    const container = document.getElementById("lighthouse-scores");
    if (!container) return;

    const rings = container.querySelectorAll<SVGCircleElement>(".score-ring");
    const numbers = container.querySelectorAll<HTMLElement>(".score-number");

    let animated = false;

    const animate = () => {
      if (animated) return;
      animated = true;

      const duration = 1200;
      const start = performance.now();
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

      const tick = (now: number) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = easeOut(progress);

        rings.forEach(ring => {
          const target = parseFloat(ring.dataset.score ?? "0");
          ring.setAttribute("stroke-dasharray", `${(target * eased).toFixed(2)}, 100`);
        });

        numbers.forEach(el => {
          const target = parseInt(el.dataset.score ?? "0", 10);
          el.textContent = String(Math.round(target * eased));
        });

        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const scoreObserver = new IntersectionObserver(
      entries => {
        if (entries[0].isIntersecting) {
          animate();
          scoreObserver.disconnect();
        }
      },
      { threshold: 0.3 }
    );

    scoreObserver.observe(container);
  }

  // Run on first load + Astro view transitions
  // ── Hero: headline drifts down slower than the page so the dock slides over it ──
  let heroListening = false;
  function initHeroParallax() {
    if (heroListening || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    heroListening = true;

    let ticking = false;
    const update = () => {
      const hero = document.getElementById("hero");
      const headline = document.getElementById("hero-headline");
      if (hero && headline) {
        const y = Math.min(window.scrollY, hero.offsetHeight);
        headline.style.transform = `translateY(${(y * 0.6).toFixed(1)}px)`;
      }
      ticking = false;
    };

    update();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
  }

  // ── "They search." card: types out local searches like someone using Google ──
  let typingStarted = false;
  function initSearchTyping() {
    const box = document.getElementById("search-box");
    const text = document.getElementById("search-typing");
    if (!box || !text || typingStarted || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    typingStarted = true;

    const searches = ["roofer near me", "plumber near me", "best bakery near me", "dentist open saturday"];
    const wait = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));

    const run = async () => {
      for (let i = 0; ; i = (i + 1) % searches.length) {
        const search = searches[i];
        // Slightly uneven speed so it reads as a person typing
        for (let n = 1; n <= search.length; n++) {
          text.textContent = search.slice(0, n);
          await wait(70 + Math.random() * 70);
        }
        await wait(1800);
        for (let n = search.length - 1; n >= 0; n--) {
          text.textContent = search.slice(0, n);
          await wait(35);
        }
        await wait(400);
      }
    };

    // Start once the card is on screen; until then it shows the first search in full
    const observer = new IntersectionObserver(
      entries => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          text.textContent = "";
          run();
        }
      },
      { threshold: 0.5 }
    );
    observer.observe(box);
  }

  function init() {
    initHeroParallax();
    initSearchTyping();
    initRevealAnimations();
    initLighthouseAnimations();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
