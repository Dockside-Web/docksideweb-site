---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CTACard from "../../components/CTACard.astro";
import readingTime from "reading-time";
import headshot from "../../assets/headshot.webp";

const allPosts = (await getCollection("blog")).sort((a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = allPosts.filter(p => p.data.featured).slice(0, 3);
const mainPost = allPosts[0];
const remainingPosts = allPosts.slice(1);
---

<Layout
  title="Blog"
  description="Practical tips on websites, SEO, and Google Business Profiles to help small businesses get found online and win more customers.">
  <PageHeader heading="Digital Strategies for Growing Small Businesses" />

  <div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12">
    <div>
      <!-- Hero/latest post card -->
      {
        mainPost && (
          <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm mb-10">
            {mainPost.data.coverImage && (
              <div class="overflow-hidden h-64">
                <img src={mainPost.data.coverImage} alt={mainPost.data.coverImageAlt} width="1200" height="630" class="w-full h-full object-cover" />
              </div>
            )}
            <div class="p-6">
              <div class="flex items-center md:gap-3 gap-1 mb-3">
                <img src={headshot.src} alt="" width="32" height="32" class="w-8 h-8 rounded-full object-cover" />
                <span class="text-sm text-slate-600">{mainPost.data.author}</span>
                <span class="text-slate-300">·</span>
                <time class="text-sm text-slate-600">
                  {mainPost.data.pubDate.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                    timeZone: "UTC"
                  })}
                </time>
                <span class="text-slate-300">·</span>
                <span class="text-sm text-slate-600">{readingTime(mainPost.body).text}</span>
              </div>
              <a href={`/blog/${mainPost.slug}/`}>
                <h2 class="text-2xl font-bold text-slate-800 hover:text-teal transition-colors mb-2">{mainPost.data.title}</h2>
              </a>
              <p class="text-slate-600 mb-5 text-sm leading-relaxed">{mainPost.data.description}</p>
              <a href={`/blog/${mainPost.slug}/`} class="inline-block px-5 py-2 bg-teal text-white text-sm font-semibold rounded hover:opacity-90 transition-opacity uppercase tracking-wide">
                Continue Reading
              </a>
            </div>
          </div>
        )
      }

      <!-- Remaining post cards -->
      <div class="flex flex-col gap-6">
        {
          remainingPosts.map(post => (
            <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm flex flex-col sm:flex-row">
              {post.data.coverImage ? (
                <div class="sm:w-48 sm:shrink-0 overflow-hidden h-48 sm:h-auto">
                  <img src={post.data.coverImage} alt={post.data.coverImageAlt} width="384" height="384" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                </div>
              ) : (
                <div class="sm:w-48 sm:shrink-0 bg-slate-100 h-48 sm:h-auto" />
              )}
              <div class="p-6 flex flex-col justify-between">
                <div>
                  <div class="flex items-center md:gap-3 gap-1 mb-2 flex-wrap">
                    <img src={headshot.src} alt="" width="28" height="28" loading="lazy" class="w-7 h-7 rounded-full object-cover" />
                    <span class="text-sm text-slate-600">{post.data.author}</span>
                    <span class="text-slate-300">·</span>
                    <time class="text-sm text-slate-600">
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                        timeZone: "UTC"
                      })}
                    </time>
                    <span class="text-slate-300">·</span>
                    <span class="text-sm text-slate-600">{readingTime(post.body).text}</span>
                  </div>
                  <a href={`/blog/${post.slug}/`}>
                    <h2 class="text-xl font-bold text-slate-800 hover:text-teal transition-colors mb-2">{post.data.title}</h2>
                  </a>
                  <p class="text-slate-600 text-sm leading-relaxed mb-4">{post.data.description}</p>
                </div>
                <a href={`/blog/${post.slug}/`} class="self-start inline-block px-5 py-2 bg-teal text-white text-sm font-semibold rounded hover:opacity-90 transition-opacity uppercase tracking-wide">
                  Continue Reading
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Sidebar -->
    <aside>
      <div class="border border-slate-200 rounded-xl p-6 sticky top-24 shadow-sm">
        <h3 class="text-lg font-bold text-slate-800 text-center mb-1">Featured Posts</h3>
        <div class="w-10 h-0.5 bg-teal mx-auto mb-6"></div>
        <div class="flex flex-col gap-6">
          {
            featuredPosts.map(post => (
              <a href={`/blog/${post.slug}/`} class="flex gap-3 group">
                {post.data.coverImage ? (
                  <div class="w-16 h-16 rounded-lg overflow-hidden shrink-0">
                    <img src={post.data.coverImage} alt="" width="64" height="64" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                  </div>
                ) : (
                  <div class="w-16 h-16 rounded-lg bg-slate-100 shrink-0" />
                )}
                <div>
                  <p class="text-sm font-semibold text-slate-800 group-hover:text-teal transition-colors leading-snug mb-1">{post.data.title}</p>
                  <time class="text-xs text-slate-500 block">
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                      timeZone: "UTC"
                    })}
                  </time>
                  <p class="text-xs text-slate-500">{readingTime(post.body).text}</p>
                </div>
              </a>
            ))
          }
          {
            featuredPosts.length === 0 && (
              <p class="text-sm text-slate-400 text-center">
                No featured posts yet.
                <br />
                Add <code class="text-xs bg-slate-100 px-1 rounded">featured: true</code> to a post's frontmatter.
              </p>
            )
          }
        </div>
      </div>
    </aside>
  </div>

  <CTACard />
</Layout>
