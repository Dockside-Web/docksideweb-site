---
import { Image } from "astro:assets";
import aboutImage from "../assets/about.webp";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";
import SectionLabel from "../components/ui/SectionLabel.astro";
import Button from "../components/ui/Button.astro";
import CTACard from "../components/CTACard.astro";
import ReviewsCarousel from "../components/ReviewsCarousel.astro";
import { startingMonthlyPrice } from "../data/pricing.ts";

const pageTitle = "About Us";
const metaDescription =
  "Meet Dockside Web Solutions, a small studio building fast, custom websites for small businesses, with hosting and ongoing support included.";
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHeader
    heading="About Dockside Web Solutions"
    description="Small studio, real relationships, websites built to last."
  />

  <Section>
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] items-center">
        <div class="relative order-last lg:order-first">
          <div class="overflow-hidden rounded-2xl shadow-2xl border-4 border-white">
            <Image src={aboutImage} alt="Photo of Riley Caldwell, the founder and developer of Dockside Web Solutions" class="w-full object-cover aspect-4/5 bg-navy/10 object-right" />
          </div>

          <div class="absolute -bottom-6 -right-6 md:right-4 bg-navy text-white p-5 rounded-xl shadow-xl min-w-55">
            <div class="flex items-center gap-4">
              <div>
                <div class="text-lg font-bold leading-tight">Riley Caldwell</div>
                <div class="text-xs uppercase tracking-widest text-teal font-semibold">Founder and Developer</div>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col order-first lg:order-last">
          <SectionLabel>About Us</SectionLabel>
          <Heading>
            The Developer Behind<br />
            <span class="italic text-teal text-pretty"> Dockside Web Solutions</span>
          </Heading>
          <div class="mt-8 space-y-5">
            <Text>
              I’m Riley Caldwell, the owner and lead developer behind Dockside Web Solutions. I studied Computer Science at UNC Wilmington and work as a software engineer while starting Dockside Web
              Solutions in 2025. The goal was simple: build websites for small businesses that actually feel fast, modern, and intentional, not like something pieced together from a template.
            </Text>

            <Text>
              The choice shouldn't have to be between a $5,000 upfront investment or a generic, clunky "DIY" template that stalls growth. Every project at Dockside Web Solutions is custom-coded from
              the ground up to eliminate WordPress bloat and recycled themes. This focus on speed, security, and clean code ensures your website functions as a high-performance, 24/7 sales tool.
            </Text>

            <Text>
              High-quality web design works best when it's accessible. Professional, custom builds start at <strong>$0 down and {startingMonthlyPrice} a month</strong> to keep your cash flow steady. With hosting, security,
              and ongoing updates completely handled, you stay focused on running your business while the technical heavy lifting is taken care of.
            </Text>
          </div>

          <div class="mt-10">
            <a href="/contact/">
              <Button>Book a Discovery Meeting</Button>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section bg="white">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <SectionLabel>Testimonials</SectionLabel>
      <Heading>Trusted to build your website for you</Heading>
    </div>
    <ReviewsCarousel count={3} />
  </Section>

  <CTACard bg="white" />
</Layout>
