---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/ui/Heading.astro";
import Section from "../components/ui/Section.astro";
import ContactForm from "../components/ContactForm.astro";
import PageHeader from "../components/PageHeader.astro";
import FAQ from "../components/FAQ.astro";
import { contactPageFAQs } from "../data/faq.ts";
import { contactInfo } from "../data/businessInfo.ts";
import { clientTestimonials } from "../data/clientInfo.ts";
import { Phone, Mail, MapPin, Star, ArrowRight, Clock } from "lucide-astro";

const pageTitle = "Contact";
const metaDescription =
  "Have a question about your next web project? Contact Dockside Web Solutions today. Send us a message or give us a call and we'll reply within 1 business day.";

const review = clientTestimonials[0];
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHeader
    compact
    heading="Contact Us"
    description="Tell us about your project and we'll follow up with next steps."
  />

  <Section bg="light">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      <div class="lg:col-span-7">
        <ContactForm />
      </div>

      <!-- Stays in view beside the form on desktop -->
      <aside class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start flex flex-col gap-6">
        <!-- Direct contact -->
        <div class="rounded-3xl bg-navy p-8 text-white">
          <h2 class="text-2xl font-semibold text-white">Prefer to talk?</h2>
          <ul class="mt-6 space-y-4">
            <li>
              <a href={contactInfo.phoneHref} class="group flex items-center gap-4">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/10 text-gold">
                  <Phone class="size-5" />
                </span>
                <span class="text-lg font-semibold transition-colors group-hover:text-gold">{contactInfo.phone}</span>
              </a>
            </li>
            <li>
              <a href={`mailto:${contactInfo.email}`} class="group flex items-center gap-4">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/10 text-gold">
                  <Mail class="size-5" />
                </span>
                <span class="text-lg font-semibold break-all transition-colors group-hover:text-gold">{contactInfo.email}</span>
              </a>
            </li>
            <li class="flex items-center gap-4">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white/10 text-gold">
                <MapPin class="size-5" />
              </span>
              <span class="text-white/80">Based in {contactInfo.locations.join(" and ")}</span>
            </li>
          </ul>
        </div>

        <!-- Reply time, backed up by a short review -->
        <div class="rounded-3xl bg-teal-light p-8">
          <div class="flex items-start gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white text-teal-hover">
              <Clock class="size-5" />
            </span>
            <div>
              <p class="text-xl font-semibold text-navy">We reply within 1 business day.</p>
              <p class="mt-1 text-slate-600">By phone or email, whichever you prefer.</p>
            </div>
          </div>

          <figure class="mt-6 border-t border-navy/10 pt-6">
            <div class="flex gap-0.5 text-gold-hover" aria-label="5 out of 5 stars">
              <Star class="size-4 fill-current" /><Star class="size-4 fill-current" /><Star class="size-4 fill-current" /><Star class="size-4 fill-current" /><Star class="size-4 fill-current" />
            </div>
            <blockquote class="mt-3 font-display text-xl text-navy leading-snug">"{review.highlight}"</blockquote>
            <figcaption class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-navy">{review.company}</span> · {review.location}
            </figcaption>
          </figure>
        </div>
      </aside>
    </div>
  </Section>

  <Section bg="white">
    <div class="text-center max-w-3xl mx-auto">
      <Heading>Common questions</Heading>
    </div>

    <FAQ items={contactPageFAQs} />

    <div class="text-center">
      <a
        href="/faq/"
        class="inline-flex items-center gap-2 font-semibold text-navy hover:text-teal-hover hover:gap-3 transition-all duration-300">
        See all FAQs <ArrowRight class="size-4" />
      </a>
    </div>
  </Section>
</Layout>
