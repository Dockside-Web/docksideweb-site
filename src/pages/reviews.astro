---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import CTACard from "../components/CTACard.astro";
import { Image } from "astro:assets";
import { clientTestimonials } from "../data/clientInfo.ts";
import { contactInfo } from "../data/businessInfo.ts";
import { Star } from "lucide-astro";

const pageTitle = "Reviews";
const metaDescription = "See what small business owners say about working with us. Read real client reviews on our website design, SEO, and support services.";
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHeader heading="Reviews" description="What our clients say about working with us." />

  <Section>
    <div class="w-full px-4" aria-label="Client testimonials">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6">
        {clientTestimonials.map((t) => (
          <div class="bg-slate-50 border border-slate-200 rounded-3xl p-6 md:p-10 flex flex-col gap-6 shadow-sm">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-full overflow-hidden border border-slate-100 shrink-0 bg-slate-50 shadow-sm">
                <Image
                  src={t.logo}
                  alt={`${t.company} logo`}
                  class="w-full h-full object-contain"
                />
              </div>
              <div>
                <p class="text-lg font-bold text-slate-900 leading-tight">{t.company}</p>
                <p class="text-sm text-slate-500">{t.location}</p>
              </div>
            </div>
            <p class="text-[16px] text-slate-600 leading-relaxed flex-1">
              "{t.quote}"
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- For past clients: straight to the Google review form -->
    <div class="mt-10 mx-4 flex flex-col md:flex-row md:items-center md:justify-between gap-6 rounded-3xl bg-navy p-8 md:p-10 text-white">
      <div>
        <div class="flex gap-0.5 text-gold" aria-hidden="true">
          <Star class="size-5 fill-current" /><Star class="size-5 fill-current" /><Star class="size-5 fill-current" /><Star class="size-5 fill-current" /><Star class="size-5 fill-current" />
        </div>
        <h2 class="mt-3 text-2xl md:text-3xl font-semibold text-white">Worked with us?</h2>
        <p class="mt-2 text-white/75">We'd love to hear how it went. It only takes a minute.</p>
      </div>
      <a
        href={contactInfo.social.googleReview}
        target="_blank"
        rel="noopener"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-gold px-7 py-3 font-semibold text-navy shadow-lg transition-colors hover:bg-gold-hover hover:text-white">
        Leave a Google review
      </a>
    </div>
  </Section>
  <CTACard />
</Layout>
