---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import CTACard from "../components/CTACard.astro";
import FAQ from "../components/FAQ.astro";
import { FAQs, faqCategories, faqCategoryId, faqCategoryIcons } from "../data/faq.ts";
import { contactInfo } from "../data/businessInfo.ts";
import { Phone, Mail, ArrowRight } from "lucide-astro";

const pageTitle = "FAQ";
const metaDescription = "Get answers about our Charleston web design services, pricing, timelines, SEO, hosting, and website redesign process.";

const categoryLinks = faqCategories.map(category => ({
  category,
  id: faqCategoryId(category),
  icon: faqCategoryIcons[category],
  count: FAQs.filter(faq => faq.category === category).length
}));
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHeader
    heading="Frequently Asked Questions"
    description="Quick answers to what most people ask before getting started."
  />

  <Section bg="light">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12">
      <!-- Jump links: stay in view beside the questions on desktop, and highlight the section you're reading -->
      <aside class="lg:col-span-4 lg:sticky lg:top-28 lg:self-start lg:mt-12 flex flex-col gap-6">
        <nav aria-label="FAQ topics" class="rounded-3xl bg-white p-3 shadow-sm ring-1 ring-navy/5">
          <p class="px-4 pt-3 pb-2 text-sm font-semibold uppercase tracking-wider text-teal-hover">Jump to</p>
          <ul class="space-y-1">
            {
              categoryLinks.map(link => (
                <li>
                  <a
                    href={`#${link.id}`}
                    data-jump={link.id}
                    class="group flex items-center gap-3 rounded-2xl p-2.5 font-semibold text-navy transition-colors hover:bg-teal-light data-active:bg-navy data-active:text-white">
                    <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-teal-light transition-colors group-hover:bg-white group-data-active:bg-white/10 group-data-active:text-gold">
                      {link.icon && <link.icon class="size-4.5" stroke-width={1.75} />}
                    </span>
                    <span class="flex-1">{link.category}</span>
                    <span class="grid min-w-7 place-items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-500 group-data-active:bg-white/10 group-data-active:text-white/80">
                      {link.count}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="hidden lg:block rounded-3xl bg-navy p-6 text-white">
          <p class="text-xl font-semibold">Still have a question?</p>
          <p class="mt-2 text-white/75">We reply within 1 business day.</p>
          <div class="mt-5 flex flex-col gap-3">
            <a href={contactInfo.phoneHref} class="flex items-center gap-2 font-semibold hover:text-gold transition-colors">
              <Phone class="size-4 shrink-0" />
              {contactInfo.phone}
            </a>
            <a href={`mailto:${contactInfo.email}`} class="flex items-center gap-2 font-semibold break-all hover:text-gold transition-colors">
              <Mail class="size-4 shrink-0" />
              {contactInfo.email}
            </a>
            <a href="/contact/" class="flex items-center gap-2 font-semibold hover:text-gold hover:gap-3 transition-all">
              Send us a message <ArrowRight class="size-4" />
            </a>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-8">
        <FAQ />
      </div>
    </div>
  </Section>

  <CTACard />
</Layout>

<script>
  // Highlight the jump link for the section currently being read
  const links = document.querySelectorAll<HTMLElement>("[data-jump]");
  const headings = [...links]
    .map(link => document.getElementById(link.dataset.jump!))
    .filter((heading): heading is HTMLElement => !!heading);

  function updateActive() {
    // The last heading that has scrolled past the top third of the screen
    const line = window.innerHeight / 3;
    let current = headings[0]?.id;
    headings.forEach(heading => {
      if (heading.getBoundingClientRect().top <= line) current = heading.id;
    });
    links.forEach(link => link.toggleAttribute("data-active", link.dataset.jump === current));
  }

  window.addEventListener("scroll", updateActive, { passive: true });
  updateActive();
</script>
