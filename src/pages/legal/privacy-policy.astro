---
import { contactInfo } from "../../data/businessInfo.ts";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CTACard from "../../components/CTACard.astro";

const lastUpdatedDate = "August 31, 2026";

const pageTitle = "Privacy Policy";
const metaDescription =
  "Read the " +
  contactInfo.businessName +
  " Privacy Policy to learn how we collect, use, and protect your data. We are committed to transparency and digital security.";
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHeader heading="Privacy Policy" description={contactInfo.businessNameFormal} />

  <div>
    <div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white shadow-lg rounded-lg overflow-hidden">
        <div class="px-6 py-8 sm:px-10 space-y-8">
          <!-- Effective Date -->
          <div class="bg-gray-100 border-l-4 border-teal p-4">
            <p class="text-sm font-semibold text-gray-700">
              Last Updated: <span class="text-teal">{lastUpdatedDate}</span>
            </p>
          </div>

          <!-- Introduction -->
          <div>
            <p class="text-gray-700 leading-relaxed">
              {contactInfo.businessNameFormal} ("{contactInfo.businessName}," "we," "us," or "our")
              operates this website (the "Site"). This Privacy Policy explains what information we
              collect, how we use it, and the choices you may have.
            </p>
          </div>

          <!-- Information We Collect -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Information We Collect</h2>

            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-semibold text-gray-800 mb-3">
                  1) Information You Provide via Contact Form
                </h3>
                <p class="text-gray-700 mb-3">
                  When you submit our contact form, we may collect information you choose to
                  provide, such as:
                </p>
                <ul class="list-disc list-inside text-gray-700 space-y-1 ml-4">
                  <li>Name</li>
                  <li>Email address</li>
                  <li>Business name</li>
                  <li>Phone number (if provided)</li>
                  <li>Message contents and any other details you include</li>
                </ul>
                <div class="mt-3 bg-blue-50 border border-blue-200 rounded-md p-3">
                  <p class="text-sm text-gray-700">
                    <span class="font-semibold">Note:</span> We use Basin to process contact form submissions.
                    When you submit the form, your information is collected and stored by Basin on our
                    behalf. Basin's privacy practices are governed by their privacy policy, which you
                    can review at
                    <a
                      href="https://usebasin.com/privacy/"
                      class="text-teal hover:underline"
                      target="_blank"
                      rel="noopener noreferrer"
                      >usebasin.com/privacy
                    </a>.
                  </p>
                </div>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-gray-800 mb-3">2) Analytics Information</h3>
                <p class="text-gray-700 mb-3">
                  We use website analytics to understand how visitors use our Site. Depending on the
                  analytics tool we use, analytics may collect information such as:
                </p>
                <ul class="list-disc list-inside text-gray-700 space-y-1 ml-4">
                  <li>Pages viewed, time on page, and referring/exit pages</li>
                  <li>Approximate location (e.g., city/region) derived from IP address</li>
                  <li>
                    Device/browser information (e.g., browser type, operating system, screen size)
                  </li>
                  <li>General usage events (e.g., clicks or navigation patterns)</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- How We Use Information -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">How We Use Information</h2>
            <p class="text-gray-700 mb-3">We use collected information to:</p>
            <ul class="list-disc list-inside text-gray-700 space-y-1 ml-4">
              <li>Respond to inquiries and communicate with you</li>
              <li>Provide and improve our Site and services</li>
              <li>Monitor Site performance, troubleshoot issues, and maintain security</li>
              <li>Understand aggregated usage trends to improve content and user experience</li>
            </ul>
          </section>

          <!-- Cookies and Tracking -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Cookies and Tracking Technologies</h2>
            <p class="text-gray-700">
              We do not intentionally use cookies for our own purposes and we do not operate a
              custom backend database for storing visitor profiles. However, our analytics provider
              may use cookies or similar technologies depending on the tool and configuration. If
              our analytics tool uses cookies, you can usually control them through your browser
              settings and/or any cookie controls we provide on the Site (if applicable).
            </p>
          </section>

          <!-- How We Share Information -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">How We Share Information</h2>
            <p class="text-gray-700 mb-3">
              We do not sell your personal information. We may share information in limited
              circumstances:
            </p>
            <div class="space-y-3">
              <div>
                <h4 class="font-semibold text-gray-800">Service Providers:</h4>
                <p class="text-gray-700">
                  We may use third-party providers (for example, analytics, Cloudflare for website
                  hosting, spam prevention, or email services) that process information on our
                  behalf to operate the Site and respond to inquiries.
                </p>
              </div>
              <div>
                <h4 class="font-semibold text-gray-800">Legal and Safety:</h4>
                <p class="text-gray-700">
                  If required by law, or to protect our rights, safety, and property, or the rights,
                  safety, and property of others.
                </p>
              </div>
              <div>
                <h4 class="font-semibold text-gray-800">Business Transfers:</h4>
                <p class="text-gray-700">
                  If we undergo a merger, acquisition, or sale of assets, information may be
                  transferred as part of that transaction.
                </p>
              </div>
            </div>
          </section>

          <!-- Data Retention -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Data Retention</h2>
            <p class="text-gray-700">
              Contact form submissions are retained only as long as needed to respond to you,
              maintain records related to our communications, or meet legal or business obligations.
              Analytics data is retained according to the settings and retention policies of our
              analytics provider.
            </p>
          </section>

          <!-- Security -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Security</h2>
            <p class="text-gray-700">
              We use reasonable administrative and technical measures designed to protect
              information. No method of transmission or storage is 100% secure, so we cannot
              guarantee absolute security.
            </p>
          </section>

          <!-- Your Choices -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Your Choices</h2>
            <p class="text-gray-700 mb-3">
              Depending on your location and applicable law, you may have rights such as:
            </p>
            <ul class="list-disc list-inside text-gray-700 space-y-1 ml-4">
              <li>Requesting access to or deletion of personal information you provided</li>
              <li>Requesting correction of inaccurate personal information</li>
              <li>
                Opting out of certain analytics tracking (when supported), or blocking cookies in
                your browser
              </li>
            </ul>
            <p class="text-gray-700 mt-3">To make a request, contact us using the details below.</p>
          </section>

          <!-- Children's Privacy -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Children's Privacy</h2>
            <p class="text-gray-700">
              Our Site is not directed to children under 13, and we do not knowingly collect
              personal information from children.
            </p>
          </section>

          <!-- Third-Party Links -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">
              Third-Party Links & External Tools
            </h2>
            <p class="text-gray-700">
              Our Site contains links to external third-party websites and services (such as online
              booking, scheduling portals, or application systems). We do not control or maintain
              these external sites. Once you click an outbound link to leave our Site, your
              browsing, transactions, and any personal information you provide are governed strictly
              by the privacy policy and terms of that third-party service, not {
                contactInfo.businessName
              }.
            </p>
          </section>

          <!-- Changes to This Policy -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Changes to This Policy</h2>
            <p class="text-gray-700">
              We may update this Privacy Policy from time to time. We will post the updated version
              on this page and revise the "Last Updated" date above.
            </p>
          </section>

          <!-- Contact Us -->
          <section class="bg-gray-50 rounded-lg p-6 border border-gray-200">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Contact Us</h2>
            <div class="text-gray-700 space-y-2">
              <p class="font-semibold text-lg">{contactInfo.businessNameFormal}</p>
              <p>
                Email: <a href={`mailto:${contactInfo.email}`} class="text-teal hover:underline"
                  >{contactInfo.email}</a
                >
              </p>
              <p>
                Phone: <a href={contactInfo.phoneHref} class="text-teal hover:underline"
                  >{contactInfo.phone}</a
                >
              </p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>

  <CTACard />
</Layout>
