---
import { Image } from "astro:assets";
import { ArrowUpRight } from "lucide-astro";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import CTACard from "../components/CTACard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { clientProjects } from "../data/clientInfo.ts";

const pageTitle = "Portfolio";
const metaDescription =
  "Browse our portfolio of custom websites for small businesses. See modern designs built for leads, speed, and growth.";

const featured = clientProjects.filter(p => p.featured);
const more = clientProjects.filter(p => !p.featured);
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHeader heading="Portfolio" description="A few of the small businesses we've built for." />

  <!-- Featured projects -->
  <Section bg="light">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14 lg:gap-x-10 animate-fade-in-up">
      {featured.map(project => <ProjectCard project={project} details />)}
    </div>
  </Section>

  <!-- Remaining projects: compact rows with a small preview -->
  <Section bg="light" class="pt-0!">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-navy mb-4">More projects</h2>
    <ul class="border-t border-slate-200">
      {
        more.map(project => (
          <li class="border-b border-slate-200">
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-5 md:gap-8 py-5 md:py-6">
              <Image
                src={project.image}
                alt=""
                widths={[240, 480]}
                sizes="(min-width: 768px) 176px, 112px"
                loading="lazy"
                class="w-28 md:w-44 aspect-16/10 shrink-0 rounded-lg object-cover object-top shadow-md ring-1 ring-slate-200 transition duration-300 group-hover:-translate-y-0.5 group-hover:shadow-lg"
              />
              <div class="flex-1 min-w-0 md:grid md:grid-cols-12 md:items-center md:gap-8">
                <div class="md:col-span-5">
                  <h3 class="text-lg md:text-xl font-semibold text-navy leading-tight">{project.client}</h3>
                  <p class="mt-1 text-sm text-slate-500">{project.industry}</p>
                </div>
                <p class="hidden md:block md:col-span-7 text-slate-600 leading-relaxed">{project.description}</p>
              </div>
              <ArrowUpRight
                class="size-5 shrink-0 text-teal-hover transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                aria-hidden="true"
              />
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <CTACard />
</Layout>
