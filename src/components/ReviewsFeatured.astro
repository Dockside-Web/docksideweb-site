---
import { Image } from "astro:assets";
import { clientTestimonials } from "../data/clientInfo.ts";

const [featured, ...rest] = clientTestimonials;
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
  <!-- Featured review -->
  <figure class="lg:col-span-7 relative overflow-hidden rounded-4xl bg-navy p-8 md:p-12 flex flex-col">
    <svg class="h-12 w-12 md:h-16 md:w-16 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M9.6 6C6.5 7.4 4.5 10.2 4.5 13.6V18h5.4v-5.4H7.2c0-2 1.2-3.8 3.2-4.7L9.6 6zm9 0c-3.1 1.4-5.1 4.2-5.1 7.6V18h5.4v-5.4h-2.7c0-2 1.2-3.8 3.2-4.7L18.6 6z" />
    </svg>
    <blockquote class="mt-6">
      <p class="font-display text-3xl md:text-5xl leading-tight text-white text-balance">
        {featured.highlight}
      </p>
      <p class="mt-6 text-white/75 leading-relaxed text-pretty">{featured.quote}</p>
    </blockquote>
    <figcaption class="mt-auto pt-10 flex items-center gap-4">
      <div class="w-14 h-14 rounded-full overflow-hidden bg-white shrink-0">
        <Image src={featured.logo} alt={`${featured.company} logo`} class="w-full h-full object-contain" />
      </div>
      <div>
        <p class="text-lg font-bold text-white leading-tight">{featured.company}</p>
        <p class="text-sm text-white/60">{featured.location}</p>
      </div>
    </figcaption>
  </figure>

  <!-- Stacked reviews -->
  <div class="lg:col-span-5 flex flex-col gap-6">
    {
      rest.map(t => (
        <figure class="flex-1 rounded-4xl bg-slate-50 border border-slate-200 p-6 md:p-8 flex flex-col">
          <blockquote>
            <p class="font-display text-xl md:text-2xl leading-snug text-navy text-balance">
              “{t.highlight}”
            </p>
          </blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full overflow-hidden bg-white border border-slate-200 shrink-0">
              <Image src={t.logo} alt={`${t.company} logo`} class="w-full h-full object-contain" />
            </div>
            <div>
              <p class="font-bold text-navy leading-tight">{t.company}</p>
              <p class="text-sm text-slate-500">{t.location}</p>
            </div>
          </figcaption>
          <details class="mt-4 group">
            <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden inline-flex items-center gap-1.5 text-sm font-semibold text-teal-hover hover:text-navy transition-colors">
              Read full review
              <svg class="h-4 w-4 transition-transform duration-300 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">{t.quote}</p>
          </details>
        </figure>
      ))
    }
  </div>
</div>
