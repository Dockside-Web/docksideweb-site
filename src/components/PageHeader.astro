---
interface Props {
  heading: string;
  description?: string;
  /** Less vertical padding, for pages where the content should start sooner */
  compact?: boolean;
}

const { heading, description, compact = false } = Astro.props;
---

<!-- Navy so the transparent nav's white links stay readable over it -->
<header
  class:list={[
    "relative overflow-hidden bg-navy text-white",
    compact ? "pt-32 pb-20 md:pt-36 md:pb-24" : "pt-36 pb-28 md:pt-44 md:pb-36"
  ]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-fade-in-up">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] text-white text-balance">
      {heading}
    </h1>
    {
      description && (
        <p class="mt-6 mx-auto max-w-2xl text-lg md:text-xl text-white/75 leading-relaxed text-pretty">
          {description}
        </p>
      )
    }
  </div>

  <!-- Layered wave: faint teal wave behind, page-colored wave in front -->
  <div class="absolute bottom-0 left-0 w-full leading-0" aria-hidden="true">
    <svg class="absolute bottom-0 block w-full h-20 md:h-28" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path
        class="fill-teal/25"
        d="M0,224L60,202.7C120,181,240,139,360,138.7C480,139,600,181,720,197.3C840,213,960,203,1080,176C1200,149,1320,107,1380,85.3L1440,64L1440,320L0,320Z"
      ></path>
    </svg>
    <svg class="relative block w-full h-16 md:h-24" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path
        class="fill-slate-50"
        d="M0,160L48,176C96,192,192,224,288,213.3C384,203,480,149,576,149.3C672,149,768,203,864,218.7C960,235,1056,213,1152,186.7C1248,160,1344,128,1392,112L1440,96L1440,320L0,320Z"
      ></path>
    </svg>
  </div>
</header>
