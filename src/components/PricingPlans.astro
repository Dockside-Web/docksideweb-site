---
import { Check, Plus } from "lucide-astro";
import Button from "./ui/Button.astro";
import { pricingPlans, formatPrice } from "../data/pricing.ts";
---

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-4 max-w-5xl mx-auto lg:items-stretch">
  {
    pricingPlans.map(plan => {
      const muted = plan.highlighted ? "text-white/75" : "text-slate-600";
      return (
        <div class={plan.highlighted ? "lg:-my-6 relative z-10" : ""}>
          <div
            class:list={[
              "rounded-3xl flex flex-col h-full p-8 transition-shadow duration-300",
              plan.highlighted
                ? "bg-navy text-white shadow-2xl"
                : "bg-white border border-navy/10 text-navy hover:shadow-md"
            ]}>
            {plan.highlighted && (
              <span class="self-start mb-4 rounded-full bg-gold px-3 py-1 text-sm font-semibold text-navy">
                Most popular
              </span>
            )}

            <h3
              class:list={[
                "text-2xl font-semibold",
                plan.highlighted ? "text-white" : "text-navy"
              ]}>
              {plan.name}
            </h3>
            <p class:list={["mt-2 leading-relaxed", muted]}>{plan.bestFor}</p>

            {/* Price */}
            <div class="mt-6 flex items-baseline gap-1.5">
              <span
                class:list={[
                  "text-5xl font-bold tracking-tight",
                  plan.highlighted ? "text-white" : "text-navy"
                ]}>
                {formatPrice(plan.price)}
              </span>
              {plan.unit && <span class:list={["text-lg", muted]}>{plan.unit}</span>}
            </div>
            <p
              class:list={[
                "mt-1 font-semibold",
                plan.highlighted ? "text-gold" : "text-teal-hover"
              ]}>
              {plan.note}
            </p>

            <a href="/contact/" class="mt-6 mb-8">
              <Button variant={plan.highlighted ? "gold" : "navyOutline"} class="w-full">
                Choose this plan
              </Button>
            </a>

            {/* What's included */}
            <div class="flex-1">
              <ul class="space-y-3">
                {plan.features.map((feature, i) => (
                  <li class="flex items-start gap-3">
                    <Check class="h-5 w-5 shrink-0 text-teal" />
                    <span class:list={["leading-snug", muted, i === 0 && "font-semibold"]}>{feature}</span>
                  </li>
                ))}
              </ul>

              {plan.addOns.length > 0 && (
                <div
                  class:list={[
                    "mt-6 pt-6 border-t",
                    plan.highlighted ? "border-white/10" : "border-navy/10"
                  ]}>
                  <p
                    class:list={[
                      "mb-3 font-semibold",
                      plan.highlighted ? "text-white" : "text-navy"
                    ]}>
                    Add-ons
                  </p>
                  <ul class="space-y-3">
                    {plan.addOns.map(addOn => (
                      <li class="flex items-start gap-3">
                        <Plus class="h-5 w-5 shrink-0 text-gold" />
                        <span class:list={["text-sm leading-snug", muted]}>{addOn}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </div>
      );
    })
  }
</div>
