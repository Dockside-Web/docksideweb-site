---
import { FAQs } from "../data/faq.ts";

interface Props {
  selectedCategories?: string[];
}

const { selectedCategories } = Astro.props;

// Categories come from the data, in the order they first appear
const allCategories = [...new Set(FAQs.map(faq => faq.category))];

const categories = selectedCategories?.length
  ? allCategories.filter(cat => selectedCategories.includes(cat))
  : allCategories;

const faqs = FAQs.filter(faq => categories.includes(faq.category));
const firstCategory = categories[0];

// Unique per category combination, so IDs don't collide if used twice on a page
const uid =
  "faq-" +
  categories
    .join("-")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-");
---

<div class="max-w-4xl mx-auto px-4 py-12" data-faq>
  {
    categories.length > 1 && (
      <div
        class="flex flex-wrap gap-3 justify-center mb-10"
        role="group"
        aria-label="FAQ categories">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class="faq-filter px-6 py-2.5 rounded-lg border border-navy/20 text-navy text-base font-semibold transition-colors duration-200 cursor-pointer hover:border-navy aria-pressed:bg-navy aria-pressed:border-navy aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal"
            data-category={cat}
            aria-pressed={idx === 0 ? "true" : "false"}>
            {cat}
          </button>
        ))}
      </div>
    )
  }

  <div class="space-y-2">
    {
      faqs.map((item, i) => (
        <div
          class="faq-item border-b border-navy/10"
          data-category={item.category}
          data-open="false"
          hidden={item.category !== firstCategory}>
          <button
            type="button"
            class="faq-question flex justify-between items-center w-full py-5 text-left text-lg font-semibold text-navy hover:text-teal transition-colors duration-200 gap-4 cursor-pointer bg-transparent border-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal"
            aria-expanded="false"
            aria-controls={`${uid}-answer-${i}`}
            id={`${uid}-btn-${i}`}>
            <span>{item.question}</span>
            <span class="faq-chevron shrink-0 text-teal">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M5 7.5L10 12.5L15 7.5"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>

          <div class="faq-answer" id={`${uid}-answer-${i}`}>
            <div>
              <p class="pb-5 pr-12 text-navy/80 text-[0.9375rem] leading-7">{item.answer}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  /* Answer panel: animates height with grid rows, no JS measuring */
  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms ease-in-out;
  }
  .faq-answer > div {
    overflow: hidden;
    visibility: hidden; /* keeps collapsed content out of the tab order */
    transition: visibility 0s linear 300ms;
  }
  .faq-item[data-open="true"] .faq-answer {
    grid-template-rows: 1fr;
  }
  .faq-item[data-open="true"] .faq-answer > div {
    visibility: visible;
    transition-delay: 0s;
  }

  .faq-chevron {
    transition: transform 300ms;
  }
  .faq-item[data-open="true"] .faq-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer,
    .faq-answer > div,
    .faq-chevron {
      transition: none;
    }
  }
</style>

<script>
  function initFAQ() {
    document.querySelectorAll<HTMLElement>("[data-faq]").forEach(root => {
      if (root.dataset.ready) return; // never bind the same instance twice
      root.dataset.ready = "true";

      const filters = root.querySelectorAll<HTMLButtonElement>(".faq-filter");
      const items = root.querySelectorAll<HTMLElement>(".faq-item");

      function setOpen(item: HTMLElement, open: boolean) {
        item.dataset.open = String(open);
        item.querySelector(".faq-question")?.setAttribute("aria-expanded", String(open));
      }

      // Category filter
      filters.forEach(btn => {
        btn.addEventListener("click", () => {
          filters.forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
          items.forEach(item => {
            const match = item.dataset.category === btn.dataset.category;
            item.hidden = !match;
            if (!match) setOpen(item, false);
          });
        });
      });

      // Accordion (one open at a time)
      root.addEventListener("click", e => {
        const btn = (e.target as HTMLElement).closest(".faq-question");
        if (!btn) return;
        const item = btn.closest<HTMLElement>(".faq-item")!;
        const willOpen = item.dataset.open !== "true";
        items.forEach(other => setOpen(other, other === item && willOpen));
      });
    });
  }

  initFAQ();
  document.addEventListener("astro:after-swap", initFAQ);
</script>
