---
import { FAQs, faqCategories, faqCategoryId, faqCategoryIcons } from "../data/faq.ts";

interface Props {
  selectedCategories?: string[];
  /** A hand-picked list, shown as one ungrouped list */
  items?: typeof FAQs;
}

const { selectedCategories, items } = Astro.props;

const categories = selectedCategories?.length
  ? faqCategories.filter(cat => selectedCategories.includes(cat))
  : faqCategories;

// With more than one category, each gets its own titled section (anchored for "Jump to" links)
const groups = items
  ? [{ category: "", items }]
  : categories.map(category => ({ category, items: FAQs.filter(faq => faq.category === category) }));
const showHeadings = groups.length > 1;

// Unique per category combination, so IDs don't collide if used twice on a page
const uid = items ? "faq-picked" : "faq-" + categories.map(faqCategoryId).join("-");

// Running index so answer IDs stay unique across groups
let index = 0;
---

<div class="max-w-4xl mx-auto px-4 py-12" data-faq>
  <!-- With several topics, each sits in its own white card -->
  <div class="space-y-6">
    {
      groups.map(group => (
        <section
          class:list={[showHeadings && "rounded-3xl bg-white p-6 md:p-8 shadow-sm ring-1 ring-navy/5"]}
          aria-labelledby={showHeadings ? faqCategoryId(group.category) : undefined}>
          {showHeadings && (() => {
            const Icon = faqCategoryIcons[group.category];
            return (
              <h2 id={faqCategoryId(group.category)} class="scroll-mt-28 mb-2 flex items-center gap-3 text-2xl md:text-3xl font-semibold text-navy">
                {Icon && (
                  <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-teal-light text-navy">
                    <Icon class="size-5" stroke-width={1.75} />
                  </span>
                )}
                {group.category}
              </h2>
            );
          })()}

          <div class="space-y-2">
            {group.items.map(item => {
              const i = index++;
              return (
                <div class:list={["faq-item border-b border-navy/10", showHeadings && "last:border-b-0"]} data-open="false">
                  <button
                    type="button"
                    class="faq-question flex justify-between items-center w-full py-5 text-left text-lg font-semibold text-navy hover:text-teal transition-colors duration-200 gap-4 cursor-pointer bg-transparent border-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal"
                    aria-expanded="false"
                    aria-controls={`${uid}-answer-${i}`}
                    id={`${uid}-btn-${i}`}>
                    <span>{item.question}</span>
                    <span class="faq-chevron shrink-0 text-teal">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </button>

                  <div class="faq-answer" id={`${uid}-answer-${i}`}>
                    <div>
                      <p class="pb-5 pr-12 text-navy/80 text-[0.9375rem] leading-7">{item.answer}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</div>

<style>
  /* Answer panel: animates height with grid rows, no JS measuring */
  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms ease-in-out;
  }
  .faq-answer > div {
    overflow: hidden;
    visibility: hidden; /* keeps collapsed content out of the tab order */
    transition: visibility 0s linear 300ms;
  }
  .faq-item[data-open="true"] .faq-answer {
    grid-template-rows: 1fr;
  }
  .faq-item[data-open="true"] .faq-answer > div {
    visibility: visible;
    transition-delay: 0s;
  }

  .faq-chevron {
    transition: transform 300ms;
  }
  .faq-item[data-open="true"] .faq-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer,
    .faq-answer > div,
    .faq-chevron {
      transition: none;
    }
  }
</style>

<script>
  function initFAQ() {
    document.querySelectorAll<HTMLElement>("[data-faq]").forEach(root => {
      if (root.dataset.ready) return; // never bind the same instance twice
      root.dataset.ready = "true";

      const items = root.querySelectorAll<HTMLElement>(".faq-item");

      function setOpen(item: HTMLElement, open: boolean) {
        item.dataset.open = String(open);
        item.querySelector(".faq-question")?.setAttribute("aria-expanded", String(open));
      }

      // Accordion (one open at a time)
      root.addEventListener("click", e => {
        const btn = (e.target as HTMLElement).closest(".faq-question");
        if (!btn) return;
        const item = btn.closest<HTMLElement>(".faq-item")!;
        const willOpen = item.dataset.open !== "true";
        items.forEach(other => setOpen(other, other === item && willOpen));
      });
    });
  }

  initFAQ();
  document.addEventListener("astro:after-swap", initFAQ);
</script>
