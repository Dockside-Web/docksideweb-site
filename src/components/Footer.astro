---
import Logo from "../assets/logo/logo-horizontal-light.svg";
import { Mail, Phone, Linkedin, MapPin } from "lucide-astro";
import { contactInfo } from "../data/businessInfo.ts";

const currentYear = new Date().getFullYear();

const linkGroups = [
  {
    title: "Services",
    links: [
      { label: "Web Design", href: "/web-design/" },
      { label: "SEO", href: "/seo/" },
      { label: "Hosting & Support", href: "/hosting-and-support/" },
      { label: "Pricing", href: "/pricing/" }
    ]
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "/about/" },
      { label: "Portfolio", href: "/portfolio/" },
      { label: "Reviews", href: "/reviews/" }
    ]
  },
  {
    title: "Resources",
    links: [
      { label: "Blog", href: "/blog/" },
      { label: "FAQ", href: "/faq/" },
      { label: "Contact", href: "/contact/" }
    ]
  }
];

const { locations } = contactInfo;
---

<footer class="relative bg-navy text-white -mt-1">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 md:pt-16 pb-8">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-x-8 gap-y-10">
      <!-- Brand + profiles -->
      <div class="col-span-2 md:col-span-12 lg:col-span-3">
        <a href="/" class="inline-block" aria-label="Dockside Web Solutions home">
          <Logo class="h-16 w-auto" aria-hidden="true" />
        </a>
        <p class="mt-4 max-w-sm text-slate-300 leading-relaxed">
          Fast, modern websites that help small businesses get found and win more customers.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a href={contactInfo.social.linkedIn} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-gold hover:text-gold">
            <Linkedin class="size-4 text-teal" />
            LinkedIn
          </a>
          <a href={contactInfo.social.googleBusinessProfile} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-gold hover:text-gold">
            <MapPin class="size-4 text-teal" />
            Google
          </a>
        </div>
      </div>

      <!-- Link groups -->
      {
        linkGroups.map(group => (
          <nav class="md:col-span-3 lg:col-span-2" aria-label={group.title}>
            <h3 class="text-gold font-semibold uppercase tracking-wider text-sm mb-4">
              {group.title}
            </h3>
            <ul class="space-y-2.5">
              {group.links.map(link => (
                <li>
                  <a href={link.href} class="text-slate-300 hover:text-white transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <!-- Contact + service area -->
      <div class="col-span-2 md:col-span-3 lg:col-span-3">
        <h3 class="text-gold font-semibold uppercase tracking-wider text-sm mb-4">Contact</h3>
        <ul class="space-y-2.5 text-slate-300">
          <li>
            <a href={`mailto:${contactInfo.email}`} class="inline-flex items-center gap-2.5 hover:text-white transition-colors">
              <Mail class="size-4 text-teal shrink-0" />
              {contactInfo.email}
            </a>
          </li>
          <li>
            <a href={contactInfo.phoneHref} class="inline-flex items-center gap-2.5 hover:text-white transition-colors">
              <Phone class="size-4 text-teal shrink-0" />
              {contactInfo.phone}
            </a>
          </li>
          {
            locations.map(location => (
              <li class="flex items-center gap-2.5">
                <MapPin class="size-4 text-teal shrink-0" />
                {location}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-12 border-t border-white/10 pt-6 flex flex-col-reverse gap-3 md:flex-row md:items-center md:justify-between text-sm text-slate-400">
      <p>© {currentYear} {contactInfo.businessNameFormal}. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href="/legal/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/legal/terms-of-service/" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
