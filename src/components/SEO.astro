---
import { contactInfo } from "../data/businessInfo.ts";

export interface Props {
  title?: string;
  description: string;
  /** Set on blog posts so search engines and social sites treat the page as an article */
  article?: {
    publishedTime: Date;
    author: string;
    image?: string;
  };
}

const { title, description, article } = Astro.props;

const brandName = "Dockside Web Solutions";
const homepageTagline = "Websites Built for Small Businesses";
// Articles share their own cover photo; other pages use the site-wide image
const socialImageURL = article?.image ?? new URL("/og-main.jpg", Astro.site).href;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// If a title exists (About, Gallery, etc.), show "Page | Brand"
// If no title exists (Home), show "Brand | Tagline"
const siteTitle = title ? `${title} | ${brandName}` : `${brandName} | ${homepageTagline}`;

// Structured data for the business itself (homepage only), so Google can connect
// the site to the Google Business Profile and LinkedIn page
const isHomepage = Astro.url.pathname === "/";
const businessSchema = isHomepage && {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: contactInfo.businessName,
  legalName: contactInfo.businessNameFormal,
  description,
  url: Astro.site?.href,
  logo: new URL("/android-chrome-512x512.png", Astro.site).href,
  image: new URL("/android-chrome-512x512.png", Astro.site).href,
  telephone: contactInfo.phoneHref.replace("tel:", ""),
  email: contactInfo.email,
  areaServed: [
    ...contactInfo.locations.map(location => ({ "@type": "City", name: location })),
    { "@type": "Country", name: "United States" }
  ],
  sameAs: [contactInfo.social.linkedIn, contactInfo.social.googleBusinessProfile]
};

// Structured data so Google knows a blog post is an article, who wrote it, and when
const articleSchema = article && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: socialImageURL,
  datePublished: article.publishedTime.toISOString(),
  author: { "@type": "Person", name: article.author },
  publisher: { "@type": "Organization", name: brandName, url: Astro.site?.href },
  mainEntityOfPage: canonicalURL
};
---

<!-- Primary -->
<title>{siteTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon-32x32.png" type="image/png" />
<link rel="icon" href="/favicon-16x16.png" type="image/png" />

<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<link rel="manifest" href="/site.webmanifest" />

<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={brandName} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      <meta property="article:author" content={article.author} />
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

{businessSchema && <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
