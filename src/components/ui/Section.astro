---
interface Props {
  class?: string;
  bg?: "white" | "light" | "tealLight" | "navy" | "teal";
  id?: string;
  pad?: boolean;
}

const { class: className = "", bg = "light", id, pad = true } = Astro.props;

const bgStyles = {
  white: "bg-white",
  light: "bg-slate-50",
  tealLight: "bg-teal-light",
  navy: "bg-navy text-white",
  teal: "bg-teal text-white"
};

const sectionClasses = `${bgStyles[bg]} ${pad ? "py-12 md:py-20" : ""} ${className} relative`;
---

<section id={id} class={sectionClasses}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <slot />
  </div>
</section>
