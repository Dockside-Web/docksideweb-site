{
  "name": "docksideweb-site",
  "compatibility_date": "2026-03-24",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    // Lets worker.js read the built files as env.ASSETS
    "binding": "ASSETS",
    // Run worker.js on every request (not just missing files) so the www and trailing-slash redirects apply
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
